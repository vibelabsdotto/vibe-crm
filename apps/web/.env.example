# API (apps/api), lokal Port 3100 — Better Auth ist dort unter /api/auth/* gemountet
NEXT_PUBLIC_API_URL=http://localhost:3100

# Absolute Web-Origin für Links (lazy verwenden, nie window im Render)
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Nur serverseitig. Automatischer lokaler Entwicklungsaccount.
# npm run dev:web setzt dies bereits; außerhalb development nicht aktivieren.
LOCAL_WEB_ACCOUNT=false
