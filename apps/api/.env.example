PORT=3100
DATABASE_PATH=./data/vibe-crm.sqlite
# 32+ random bytes (e.g. `openssl rand -base64 32`). The API refuses to start
# with the placeholder below.
BETTER_AUTH_SECRET=replace-me
WEB_BASE_URL=http://localhost:3000
# Every account sees the whole workspace. Set to true on any instance reachable
# from the internet once your accounts exist; sign-in keeps working.
# AUTH_DISABLE_SIGNUP=true
CORS_ORIGIN=http://localhost:3000
# Explicit local opt-in, never enable in production. Also set this server-only
# flag for apps/web. Requires NODE_ENV=development and a literal loopback
# WEB_BASE_URL; invalid enabled configurations refuse to start.
# The API binds 127.0.0.1, rejects forwarding headers and checks socket, Host,
# and optional exact Origin. Do not expose either local dev server via a proxy.
# Creates one persisted passwordless local user, not a Better Auth session/cookie.
# LOCAL_WEB_ACCOUNT=true
# NODE_ENV=development
# optional: Google OAuth is enabled only when BOTH are set
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
